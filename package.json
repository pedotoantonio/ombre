{
  "name": "ombre",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @ombre/web dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "check": "pnpm lint && turbo run typecheck test build",
    "smoke": "node scripts/smoke.ts",
    "test:db": "sh scripts/test-db.sh",
    "smoke:api": "node scripts/smoke-api.ts",
    "smoke:flow": "node scripts/smoke-flow.ts",
    "smoke:booking": "node scripts/smoke-booking.ts",
    "smoke:areas": "node scripts/smoke-areas.ts",
    "smoke:site": "node scripts/smoke-site.ts",
    "smoke:2fa": "node scripts/smoke-2fa.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
