# Valori letti al momento della build delle pagine pubbliche.
# Nome mostrato nelle pagine: resta una proposta finche' il marchio non e' verificato.
OMBRE_BRAND_NAME=Ombrè
# Indirizzo pubblico principale, senza barra finale. Usato per canonical, hreflang e sitemap.
OMBRE_SITE_URL=http://localhost:3210
# true solo sul sito pubblico definitivo: altrimenti le pagine chiedono di non essere indicizzate.
OMBRE_INDEXABLE=false
# true solo quando le prenotazioni sono realmente attive.
OMBRE_BOOKINGS_OPEN=false
# Indirizzo di contatto pubblico. Vuoto: le pagine dicono che i contatti non sono ancora disponibili.
OMBRE_CONTACT_EMAIL=

# --- API e database ---
# Durata della riserva in minuti. Proposta del progetto: 10.
OMBRE_HOLD_MINUTES=10
# true crea lo stabilimento dimostrativo "Bagno delle Dune". Solo in ambiente di prova.
OMBRE_SEED_DEMO=false
# Password di sviluppo: in produzione si usano i Docker secrets.
OMBRE_DB_OWNER_PASSWORD=
OMBRE_DB_APP_PASSWORD=
# Con OMBRE_SEED_DEMO=true crea anche tre accessi dimostrativi (gestore, reception,
# contabilita @bagnodelledune.example) con questa password, di almeno 12 caratteri.
OMBRE_DEMO_PASSWORD=
# Crea o aggiorna l'amministratore della piattaforma.
OMBRE_ADMIN_EMAIL=
OMBRE_ADMIN_PASSWORD=
# Firma i collegamenti alle prenotazioni e i pass. Almeno 32 caratteri, da tenere segreto.
OMBRE_SIGNING_SECRET=
# Segreto condiviso con il fornitore di pagamento di prova. Vuoto: fornitore di prova spento.
# In produzione deve restare vuoto.
OMBRE_SANDBOX_WEBHOOK_SECRET=
# Posta: "none" non invia nulla, "log" scrive nel registro cio' che invierebbe.
# Nessun fornitore reale e' ancora collegato.
OMBRE_MAIL_PROVIDER=none
OMBRE_WORKER_INTERVAL_SECONDS=15
# true in produzione: il gestore deve attivare la verifica in due passaggi per lavorare.
OMBRE_REQUIRE_2FA=false
# true crea anche "Lido Aurora", uno stabilimento di fantasia piu' grande con immagini,
# abbonamenti, proposte e prenotazioni gia' fatte. Solo in ambiente di prova. Vedi docs/demo.md.
OMBRE_SEED_SHOWCASE=false
